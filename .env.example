# Jira MCP Server Configuration

# Required: Your Jira instance host (without protocol)
JIRA_HOST=your-company.atlassian.net

# Required: Your Jira username (email address for Atlassian Cloud)
JIRA_USERNAME=your.email@company.com

# Authentication: Use either password OR API token (recommended)
# For Jira Cloud, use API token (recommended for security)
JIRA_API_TOKEN=your_personal_access_token_here

# For Jira Server/Data Center, you can use password instead
# JIRA_PASSWORD=your_password_here

# Optional: Protocol (default: https)
# JIRA_PROTOCOL=https

# Optional: API version (default: 2)
# JIRA_API_VERSION=2

# Optional: SSL verification (default: true)
# JIRA_STRICT_SSL=true

# Optional: custom header for reverse-proxy/SSO gates that block /secure/* paths
# even with Bearer auth (e.g. Skyeng gandalf redirects /secure/attachment/* to
# Yandex Browser SSO). Format: "Header-Name: value". Nothing is added if unset.
# Example: JIRA_CUSTOM_HEADER=custom-header:custom-token
# JIRA_CUSTOM_HEADER=
